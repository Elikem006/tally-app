# Copy to .env.local (gitignored) and set to the URL your phone can reach
# the backend on. For local dev that is the LAN/hotspot IP of the machine
# running `docker-compose up` in tally-backend/ (NOT localhost — the phone
# can't reach your machine's loopback), port 8082 (the api-gateway).
#
# After changing this value, restart Expo with `npx expo start --clear` —
# EXPO_PUBLIC_* vars are inlined at build time, so a plain reload/hot-refresh
# will NOT pick up the change.
EXPO_PUBLIC_API_URL=http://192.168.x.x:8082
