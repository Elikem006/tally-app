{
  "expo": {
    "name": "Tally",
    "slug": "tally-app",
    "version": "1.0.0",
    "scheme": "tally",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F1117"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tally.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1117"
      },
      "package": "com.tally.app"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
