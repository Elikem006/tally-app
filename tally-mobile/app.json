{
  "expo": {
    "name": "Tally",
    "slug": "tally-app",
    "version": "1.0.2",
    "scheme": "tally",
    "orientation": "portrait",
    "icon": "./assets/icon-tally.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1115"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tally.app",
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-tally-adaptive.png",
        "backgroundColor": "#0F1115"
      },
      "package": "com.tally.app",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4F46E5",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tally needs access to your photos to set a profile picture.",
          "cameraPermission": "Tally needs access to your camera to take a profile photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d674978a-cac5-4baa-ac3a-b916701cf051"
      }
    },
    "owner": "tally-mobile-app"
  }
}
