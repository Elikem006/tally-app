# Copy to .env (gitignored) and fill in as needed. Everything has a working
# default for local dev — you only need this file to enable MoMo or to change
# the JWT secret.

# JWT_SECRET=your-own-secret-at-least-32-characters-long
# ALLOWED_ORIGINS=*

# MTN MoMo sandbox (optional — MoMo endpoints return errors if unset, all
# other functionality works fine without them)
# MOMO_SUBSCRIPTION_KEY=
# MOMO_API_USER=
# MOMO_API_KEY=
# MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
# MOMO_DISBURSEMENT_API_USER=
# MOMO_DISBURSEMENT_API_KEY=

# Outbound email — password-reset OTP (optional — if unset, the email send
# is skipped and the forgot-password endpoint returns an error unless
# OTP_DEBUG_EXPOSE=true). Once the student-pack domain + ESP (Mailgun or
# SendGrid) are set up, these are the only 6 values that change — see
# tally-backend/EMAIL-DELIVERABILITY-SETUP.md.
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=Tally
# MAIL_REPLY_TO=
# OTP_DEBUG_EXPOSE=false
