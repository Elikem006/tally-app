# Spring Boot configuration — tracked in git, placeholder values only.
# For Railway: set each ${VAR_NAME} as an environment variable in the Railway dashboard.
# For local dev: override values in application-local.properties (gitignored),
#   then run with SPRING_PROFILES_ACTIVE=local.

spring.application.name=budget-service

# Railway injects PORT automatically; 8092 is the local fallback.
# Locally this service sits BEHIND the api-gateway (port 8082) — the mobile
# app must never call this port directly.
server.port=${PORT:8092}

# ---------------------------------------------------------------------------
# Database — shared Neon PostgreSQL (same DB across all Tally services)
# ---------------------------------------------------------------------------
spring.datasource.url=jdbc:postgresql://${DB_HOST}/${DB_NAME}?sslmode=require
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.properties.hibernate.jdbc.use_get_generated_keys=true

# validate ONLY — the schema is shared with the other Tally services and is
# never altered from here. Do not change to 'update' or 'create'.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.jdbc.batch_size=20
spring.jpa.open-in-view=false

# INCLUDE_ERROR_MESSAGES: 'always' for dev, 'never' for production
server.error.include-message=${INCLUDE_ERROR_MESSAGES:always}

# ---------------------------------------------------------------------------
# JWT — MUST be the same JWT_SECRET across ALL Tally services.
# auth-service issues tokens; the others only validate them.
# ---------------------------------------------------------------------------
jwt.secret=${JWT_SECRET}

# ---------------------------------------------------------------------------
# CORS — external CORS is centralized at the api-gateway. This service-level
# setting stays permissive because only the gateway reaches this service.
# ---------------------------------------------------------------------------
app.cors.allowed-origins=${ALLOWED_ORIGINS:*}

# ---------------------------------------------------------------------------
# Inter-service URLs — this service calls other Tally services over HTTP only
# (never their tables). Direct service URLs, not the gateway.
# ---------------------------------------------------------------------------
services.expense-url=${EXPENSE_SERVICE_URL:http://localhost:8091}
